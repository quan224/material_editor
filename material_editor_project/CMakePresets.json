{
    "version": 3,
    "vendor": {
        "description": "材质编辑器项目 CMake 预设（双工具链：MinGW 本地 + MSVC 备用）"
    },
    "configurePresets": [
        {
            "name": "mingw",
            "displayName": "MinGW (MSYS2)",
            "description": "MSYS2 MinGW-w64 + Qt6。显式指定编译器路径，绕过系统 PATH 里旧 MinGW 的冲突。",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build-mingw",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_C_COMPILER": "C:/msys64/mingw64/bin/gcc.exe",
                "CMAKE_CXX_COMPILER": "C:/msys64/mingw64/bin/g++.exe",
                "CMAKE_MAKE_PROGRAM": "C:/msys64/mingw64/bin/ninja.exe"
            }
        },
        {
            "name": "vcpkg-vs2022",
            "displayName": "vcpkg + VS2022",
            "description": "使用 vcpkg 工具链 + Visual Studio 2022 生成器",
            "generator": "Visual Studio 17 2022",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake"
            }
        },
        {
            "name": "default",
            "displayName": "默认配置",
            "description": "继承 mingw，作为本地默认选项",
            "inherits": "mingw"
        }
    ],
    "buildPresets": [
        {
            "name": "mingw-debug",
            "configurePreset": "mingw"
        },
        {
            "name": "debug",
            "configurePreset": "vcpkg-vs2022",
            "configuration": "Debug"
        },
        {
            "name": "release",
            "configurePreset": "vcpkg-vs2022",
            "configuration": "Release"
        }
    ]
}
